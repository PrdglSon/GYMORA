{
  "name": "gymora",
  "private": true,
  "version": "1.0.0",
  "description": "GYMORA: a web-based fitness management information system (MERN)",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "frontend": "npm run dev --prefix frontend",
    "seed": "npm run seed --prefix backend",
    "seed:reset": "npm run seed --prefix backend -- --reset",
    "seed:owner": "npm run seed:owner --prefix backend",
    "check": "npm run check --prefix backend",
    "build": "npm run build --prefix frontend"
  }
}
